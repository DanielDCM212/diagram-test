ANTHROPIC_API_KEY=sk-ant-.....ssssss

# ADK session-state persistence (google.adk.sessions.DatabaseSessionService).
# Must use an async driver -- asyncpg for Postgres, not psycopg/psycopg2.
# Same database as the iag_* business tables is fine; ADK creates its own
# tables there (sessions, events, app_states, user_states, adk_internal_metadata).
ADK_SESSION_DB_URL=postgresql+asyncpg://user:password@host:5432/dbname
