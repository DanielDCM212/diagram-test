        </mxCell>
        <mxCell id="c7" value="What the business should expect&lt;br&gt;Reliable for light and medium overlap: a few boxes touching or partly covering each other. Result is validated before it is saved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
