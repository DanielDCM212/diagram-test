        <mxCell id="c6" value="What happens&lt;br&gt;Arrows connected to boxes at both ends follow when boxes move. An arrow with a loose end keeps its loose end at the old position, so it can end in empty space or inside another box." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="20" y="550" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="What the business should expect&lt;br&gt;Diagrams drawn with hand-placed arrow ends need a visual check after any move. The tool warns when such arrows exist. Fix: connect the arrow end to the box." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="580" y="550" width="520" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="b07c0241-311f-4cd1-97bb-129083c6e444" name="7. Arrows through boxes">
    <mxGraphModel dx="970" dy="405" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="7. Arrows through boxes - not detected" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="1040" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="A straight arrow from Web App to Orders API goes right through the Cache box. Boxes do not overlap each other." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="20" y="48" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="REAL TOOL REPORT  overlaps: 0 -&gt; 0   moved: 0   resized: 0   fonts changed: 0   still overlapping: 0   labels still overflowing: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="20" y="92" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="BEFORE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="AFTER (actual tool output)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="580" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b_a" value="Web App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="280" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_b" value="Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="250" y="265" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_c" value="Orders API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="420" y="280" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_e1" value="" style="endArrow=block;html=1;strokeColor=#333333;" parent="1" source="b_a" target="b_c" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_a" value="Web App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="640" y="280" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_b" value="Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="810" y="265" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a_c" value="Orders API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="980" y="280" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_e1" value="" style="endArrow=block;html=1;strokeColor=#333333;" parent="1" source="a_a" target="a_c" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="What happens&lt;br&gt;The tool only looks at boxes. It does not see arrows passing through boxes, arrows crossing each other, or labels sitting on lines. It reports 0 overlaps and changes nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="20" y="550" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="What the business should expect&lt;br&gt;A clean report does not mean a clean diagram. The preview (and a human look) is still needed for arrow routing. Edge routing clean-up is not part of this tool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="580" y="550" width="520" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="7349ae12-a40d-4d5b-b6de-6bda1bc2cd49" name="8. Round shapes">
    <mxGraphModel dx="970" dy="405" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="8. Round shapes - treated as rectangles" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="1040" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Circles and diamonds whose corners (bounding boxes) overlap, while the visible shapes do not touch." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="20" y="48" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="REAL TOOL REPORT  overlaps: 1 -&gt; 0   moved: 2   resized: 0   fonts changed: 0   still overlapping: 0   labels still overflowing: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="20" y="92" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="BEFORE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="AFTER (actual tool output)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="580" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b_c1" value="Cloud" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="100" y="230" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b_c2" value="On-prem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="190" y="320" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b_d1" value="Rotated" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="390" y="250" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_d2" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="440" y="300" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_c1" value="Cloud" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="640" y="230" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a_c2" value="On-prem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="770" y="320" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a_d1" value="Rotated" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="950" y="250" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_d2" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1000" y="300" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="What happens&lt;br&gt;Overlap is measured on each shape&#39;s bounding rectangle. Round or diamond shapes placed diagonally are reported as overlapping and get moved even though they were fine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="20" y="550" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="What the business should expect&lt;br&gt;Some unnecessary movement, mostly with circles, diamonds and rotated shapes. Harmless but visible. Use lock for shapes that were placed deliberately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="580" y="550" width="520" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bc2298c9-76e1-4f15-aca8-df708a3e18eb" name="9. Ripple effect">
    <mxGraphModel dx="970" dy="405" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="9. Ripple effect - one fix can move neighbours" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="1040" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Two services overlap inside Zone 1. The three zones are packed edge to edge, with no free space between them." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="20" y="48" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="REAL TOOL REPORT  overlaps: 1 -&gt; 0   moved: 5   resized: 0   fonts changed: 0   still overlapping: 0   labels still overflowing: 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="20" y="92" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="BEFORE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="20" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="AFTER (actual tool output)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="580" y="130" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b_z1" value="Zone 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="220" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b_z2" value="Zone 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="210" y="220" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b_z3" value="Zone 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="350" y="220" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="b_a1" value="Service A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="250" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_a2" value="Service B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="255" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_b1" value="Service C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="250" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_c1" value="Service D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="360" y="250" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_z1" value="Zone 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="588.8" y="220" width="180" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a_z2" value="Zone 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="778.8" y="220" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a_z3" value="Zone 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="922.5" y="220" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a_a1" value="Service A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="598.8" y="250" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_a2" value="Service B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="678.8" y="255" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_b1" value="Service C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="788.8" y="250" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a_c1" value="Service D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="932.5" y="250" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="What happens&lt;br&gt;Fixing the overlap inside Zone 1 makes the zone grow. The grown zone pushes Zone 2, which pushes Zone 3: a small local problem moves several areas. Pushed neighbours can also end up closer together than the usual spacing, because clearance is only added when a pair is pushed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="20" y="550" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="What the business should expect&lt;br&gt;On tightly packed diagrams a fix can shift more than the overlapping boxes. Each box moves at most the limit, and the report lists everything that moved. Use &#39;only&#39; to restrict the clean-up to one area." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="580" y="550" width="520" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cae0e351-0cff-4e15-a23b-87a63ecac576" name="10. Other limits">
    <mxGraphModel dx="970" dy="187" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="10. Other limits that are not easy to draw" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="10" width="1040" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Preview accuracy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="60" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Without the draw.io export server the preview is a schematic drawing (straight arrows, no icons). Real draw.io rendering needs the export server to be reachable. Falls back automatically, and says which one was used." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="60" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Text fit is an estimate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="124" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Label fit uses standard font measurements, not draw.io&#39;s own renderer. Expect occasional labels that still look tight or are shrunk more than needed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="124" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Only the first page of a file is edited" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="188" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Describe and preview accept a page number, but edit operations act on the first page only." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="188" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="New diagrams depend on reference diagrams" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="252" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Creating a diagram in the house style needs the reference diagrams installed. Without them the agent must say it is not in house style." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="252" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Judgement calls stay with the model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="316" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Requests like &#39;identify the AWS zone&#39; rely on the labels and shapes in the file. With several candidates or unusual names the agent can pick the wrong one: ask it to state what it picked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="316" width="780" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Placeholders are shown raw" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="20" y="380" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Labels such as %owner% (draw.io placeholders) are shown as written, not resolved to the property value." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacing=8;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="380" width="780" height="64" as="geometry" />
        </mxCell>
