        </mxCell>
        <mxCell id="c6" value="What happens&lt;br&gt;Locked boxes are never moved or resized, so an overlap between two locked boxes cannot be fixed. Only unlocked neighbours may move." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=13;" parent="1" vertex="1">
